@@ -1525,7 +1525,18 @@ impl<'a> Lower<'a> {
         // part is NaN. Metal's sin and cos give 0 there, so that NaN is
         // passed through here instead of relying on the host.
         let nan = self.s.m.cmp(c, pred::UNO, part, part);
-        self.s.m.select(c, nan, part, r)
+        let r = self.s.m.select(c, nan, part, r);
+        if cosine {
+            return r;
+        }
+        // D3DMetal on M1 Max can turn sin(-0) into +0. Preserve this
+        // one input by its IEEE bits, after the host transcendental.
+        let input = self.as_int(x);
+        let negative_zero = self.s.m.i32(0x8000_0000);
+        let is_negative_zero = self.s.m.cmp(c, pred::EQ, input, negative_zero);
+        let result = self.as_int(r);
+        let bits = self.s.m.select(c, is_negative_zero, negative_zero, result);
+        self.as_float(bits)
     }
 
